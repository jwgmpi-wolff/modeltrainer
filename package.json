{
  "name": "modeltrainer",
  "private": true,
  "version": "1.0.1",
  "description": "Local fine-tuning and model management desktop application",
  "author": "Jerry Wolff",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "dev:frontend": "vite --host 127.0.0.1 --port 3000",
    "dev:server": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win --dir",
    "desktop:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:local": "powershell -ExecutionPolicy Bypass -File scripts/deploy-to-local-machine.ps1",
    "deploy:static": "npm run build",
    "check": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.447.0",
    "multer": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.localmodellab.desktop",
    "productName": "Local Model Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "electron/**/*",
      "server/**/*.js",
      "server/package.json",
      "server/node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "samples",
        "to": "samples",
        "filter": [
          "**/*.jsonl"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    }
  }
}
